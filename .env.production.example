# ============================================================
# WebGIS LAN Production Environment Variables Template
# Copy this file to .env.production or .env before deployment
# ============================================================

# Web Server Gateway Port (Port mở ra mạng LAN)
WEB_PORT=80

# PostgreSQL / PostGIS Database Settings
POSTGRES_DB=webgis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here

# MinIO S3 Object Storage Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here

# Security & JWT Authentication
JWT_SECRET_KEY=generate_a_random_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Account Seed (Khởi tạo Admin lần đầu)
DEFAULT_ADMIN_EMAIL=admin@webgis.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_FULLNAME=System Administrator
DEFAULT_ADMIN_PHONE=0987654321

